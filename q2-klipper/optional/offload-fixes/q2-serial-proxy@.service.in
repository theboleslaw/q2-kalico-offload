# Printer board side: expose one MCU serial port over TCP to the Klipper host.
# Instance = main | thr | mmu, settings in /etc/q2-serial-proxy/<instance>.env
#
# Optional offload fix. Unlike the socat unit, q2-serial-proxy.py opens the
# serial device once and keeps it open while clients reconnect.
[Unit]
Description=Q2 MCU serial proxy (%i)
After=network-online.target
Wants=network-online.target
# Keep retrying while the other side is down (printer off, rebooting): the default
# start limit gives up after 5 failures in 10 s and leaves the link dead.
StartLimitIntervalSec=0

[Service]
EnvironmentFile=/etc/q2-serial-proxy/%i.env
ExecStart=@PYTHON@ /usr/local/sbin/q2-serial-proxy.py
Restart=always
RestartSec=1
Nice=-10

[Install]
WantedBy=multi-user.target
