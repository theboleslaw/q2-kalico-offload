MAINSAIL_CONFIG_REPO=https://github.com/mainsail-crew/mainsail-config.git
MAINSAIL_CONFIG_BRANCH=master
MAINSAIL_CONFIG_REF=ff3869a621db17ce3ef660adbbd3fa321995ac42

# Arm GNU Toolchain: compiles the MCU firmware on the Klipper machine. The same compiler built
# vendor/firmware, so both builds match. SHA-256 from Arm's published .sha256asc file.
ARM_TOOLCHAIN_VERSION=15.3.rel2
ARM_TOOLCHAIN_URL=https://gitlab.arm.com/api/v4/projects/tooling%2Fgnu-toolchains-for-arm/packages/generic/gnu-toolchain/15.3.rel2/arm-gnu-toolchain-15.3.rel2-x86_64-arm-none-eabi.tar.xz
ARM_TOOLCHAIN_SHA256=463df9665c246fa13bab2102115bbf83440661b6eb70b44f3dfd4712ca30037a

MAINSAIL_VERSION=v2.19.0
SPOOLMAN_VERSION=v0.27.0

# HelixScreen (printer touchscreen UI). Installed on the printer, not the host;
# the macros in config/klipper/helix_macros.cfg integrate with it.
HELIXSCREEN_REPO=https://github.com/prestonbrown/helixscreen.git
HELIXSCREEN_RELEASE=v1.0.7
HELIXSCREEN_REF=faed4e35010e970ba5612e9b2e109c52a11965a6

