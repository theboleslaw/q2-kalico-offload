# Pinned upstream versions. Sourced by install.sh, the build scripts and CI.
# The "bump" workflow rewrites the *_REF / *_VERSION lines; keep one KEY=value per line.

# Klipper (host + MCU firmware are always built from this exact tree + patches/klipper).
# Here "Klipper" is actually Kalico (KalicoCrew/kalico, bleeding-edge-v2): the Q2 patch
# series in patches/klipper is written against it.
KLIPPER_REPO=https://github.com/KalicoCrew/kalico.git
KLIPPER_BRANCH=bleeding-edge-v2
KLIPPER_REF=e0a57a0b55c65d8b9112c812a01bd32f88476618

# Happy Hare (MMU software for the Qidi Box) + patches/happy-hare. Follows its GitHub
# releases (its main branch moves with every merge): HAPPY_HARE_REF is the release's commit.
HAPPY_HARE_REPO=https://github.com/moggieuk/Happy-Hare.git
HAPPY_HARE_RELEASE=v4.1.0
HAPPY_HARE_REF=1ac0303c6f83c09f4ae8254dbebf8b4128e637c5

MOONRAKER_REPO=https://github.com/Arksine/moonraker.git
MOONRAKER_BRANCH=master
MOONRAKER_REF=9e676eba6b02661a4dfa3ec6e7ac3f3504498e6d

# Katapult: only flashtool.py is used (the bootloaders come from the deployers below)
KATAPULT_REPO=https://github.com/Arksine/katapult.git
KATAPULT_BRANCH=master
KATAPULT_REF=3b973a485388b4ef0f9efef46f78152e302aea8e

TIMELAPSE_REPO=https://github.com/mainsail-crew/moonraker-timelapse.git
